# ------------------------------------------------------------------
# EduNest LMS — Backend environment variables
# Copy this file to `.env` and fill in your own values.
#   cp .env.example .env
# Never commit the real `.env` file.
# ------------------------------------------------------------------

# Server
PORT = 5014

# Database
MONGODB_URL = mongodb://127.0.0.1:27017/edunest_lms

# Authentication
JWT_SECRET = change_this_to_a_long_random_secret
JWT_EXPIRY = 7d

# Frontend
FRONTEND_URL = http://localhost:5173

# Contact form recipient
CONTACT_US_EMAIL = your_email@example.com

# Cloudinary (course thumbnails + lecture videos)
CLOUDINARY_CLOUD_NAME = your_cloud_name
CLOUDINARY_API_KEY = your_api_key
CLOUDINARY_API_SECRET = your_api_secret

# SMTP (password reset emails)
SMTP_HOST = smtp.gmail.com
SMTP_PORT = 587
SMTP_USERNAME = your_email@example.com
SMTP_PASSWORD = your_app_password
SMTP_FROM_EMAIL = your_email@example.com

# ------------------------------------------------------------------
# AI Quiz Generator (optional - works offline without these)
# ------------------------------------------------------------------
GEMINI_API_KEY = your_gemini_api_key
GEMINI_MODEL = gemini-3.5-flash
OPENAI_API_KEY = your_openai_api_key
OPENAI_MODEL = gpt-4o-mini
